# Session environment, loaded by Hyprkarl's ~/.config/uwsm/env. Changes need a
# new session. This file is public (ejarmand/configs): keep secrets such as
# API keys in ~/.config/uwsm/env.secrets, which is not tracked.

# Terminal for programs that read $TERMINAL
export TERMINAL=ghostty

# Screenshot and screen recording folders
export HYPRSHOT_DIR="$HOME/Pictures/screenshots"
export HYPRKARL_SCREENRECORD_DIR="$HOME/Videos/screenrecord"

if [[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/uwsm/env.secrets" ]]; then
  source "${XDG_CONFIG_HOME:-$HOME/.config}/uwsm/env.secrets"
fi
